cat << 'EOF' > .env.example
# Database Configurations
DB_URL=mongodb://localhost:27017/sawaari

# Authentication 
JWT_SECRET=your_jwt_secret_key_here

# Third-Party Maps & Traffic API
GOOGLE_MAPS_API_KEY=your_google_maps_key_here

# Payment Processing
STRIPE_API_KEY=your_stripe_key_here

# Push Notifications & OTP Auth
FIREBASE_CONFIG=your_firebase_config_json_string_here
EOF